# Install KPT binary
wget https://github.com/GoogleContainerTools/kpt/releases/download/v1.0.0-beta.44/kpt_linux_amd64
chmod +x kpt_linux_amd64
sudo mv kpt_linux_amd64 /usr/local/bin/kpt


# Install The Nephio Resources

export NEPHIO_VERSION=v3.0.0
kpt pkg get --for-deployment https://github.com/nephio-project/catalog/nephio/core/porch@${NEPHIO_VERSION}
kpt fn render porch
kpt live init porch
kpt live apply porch --reconcile-timeout=15m --output=table

kpt pkg get --for-deployment https://github.com/nephio-project/catalog.git/nephio/optional/network-config@@origin/v3.0.0
kpt fn render network-config
kpt live init network-config
kpt live apply network-config --reconcile-timeout=15m --output=table

kpt pkg get --for-deployment https://github.com/nephio-project/catalog.git/nephio/optional/resource-backend@@origin/v3.0.0
kpt fn render resource-backend
kpt live init resource-backend
kpt live apply resource-backend --reconcile-timeout=15m --output=table

kpt pkg get --for-deployment https://github.com/nephio-project/catalog.git/nephio/core/nephio-operator@${NEPHIO_VERSION}
kpt fn render nephio-operator
kpt live init nephio-operator
kpt live apply nephio-operator --reconcile-timeout=15m --output=table

sudo apt-get install docker.io
kpt pkg get --for-deployment https://github.com/nephio-project/catalog/nephio/optional/webui@${NEPHIO_VERSION}
sudo kpt fn eval webui --image gcr.io/kpt-fn/search-replace:v0.2.0 --match-kind Service -- 'by-path=spec.type' 'put-value=NodePort'
sudo kpt fn render webui
kpt live init webui
kpt live apply webui --reconcile-timeout=15m --output=table --inventory-policy=adopt

# Export your Github credentials
export GITHUB_USERNAME="infinitydon"
export GITHUB_PAT=""

kpt alpha repo register \
  --namespace default \
  --name nephio-proxmox-packages \
  --branch r3 \
  https://github.com/infinitydon/nephio-proxmox-packages.git

kpt alpha repo register \
  --namespace default \
  --name mgmt \
  --deployment \
  --repo-basic-username=${GITHUB_USERNAME} \
  --repo-basic-password=${GITHUB_PAT} \
  https://github.com/${GITHUB_USERNAME}/prox-telco-mgmt-5g.git